#cloud-config
package_update: true
package_upgrade: true

packages:
  - apt-transport-https
  - bc
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-plugin
  - gpg
  - jq
  - make
  - nodejs
  - npm
  - sysstat
  - unzip

write_files:
  - path: /usr/local/bin/setup-benchmark-runners.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      RUNNER_VERSION="${runner_version}"
      RUNNER_URL="${github_runner_url}"
      RUNNER_TOKEN="${github_runner_token}"
      RUNNER_LABEL="${github_runner_label}"
      RUNNER_COUNT="${runner_count}"

      install -d -m 0755 /opt/actions-runner
      cd /opt/actions-runner

      if [ ! -f "actions-runner-linux-arm64-${runner_version}.tar.gz" ]; then
        curl -fsSL -o "actions-runner-linux-arm64-${runner_version}.tar.gz" \
          "https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-arm64-${runner_version}.tar.gz"
      fi

      for i in $(seq 1 "$RUNNER_COUNT"); do
        RUNNER_DIR="/opt/actions-runner/${i}"
        if [ -f "$RUNNER_DIR/.runner" ]; then
          continue
        fi

        install -d -m 0755 "$RUNNER_DIR"
        tar xzf "actions-runner-linux-arm64-${runner_version}.tar.gz" -C "$RUNNER_DIR"
        chown -R ubuntu:ubuntu "$RUNNER_DIR"

        sudo -u ubuntu bash -lc "
          cd '$RUNNER_DIR' && \
          ./config.sh \
            --unattended \
            --replace \
            --name '${server_name}-${i}' \
            --url '$RUNNER_URL' \
            --token '$RUNNER_TOKEN' \
            --labels '$RUNNER_LABEL' \
            --work '_work'
        "

        "$RUNNER_DIR"/svc.sh install ubuntu
        "$RUNNER_DIR"/svc.sh start
      done

runcmd:
  - usermod -aG docker ubuntu
  - bash -lc "curl -fsSL https://dl.k6.io/key.gpg | gpg --dearmor -o /usr/share/keyrings/k6-archive-keyring.gpg"
  - bash -lc "echo 'deb [signed-by=/usr/share/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main' > /etc/apt/sources.list.d/k6.list"
  - apt-get update
  - apt-get install -y k6 linux-tools-generic
  - systemctl enable --now docker
  - /usr/local/bin/setup-benchmark-runners.sh
